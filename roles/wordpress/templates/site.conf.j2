# {{ ansible_managed }}

# Everything on :80 is redirected; the site is only served over TLS.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

# Requests for a name we do not serve get a flat refusal rather than
# silently landing on the WordPress vhost.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    return 444;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ wordpress_domain }} www.{{ wordpress_domain }};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Docker's embedded DNS. Needed for the per-request upstream lookup
    # below; see the comment in the PHP location.
    resolver 127.0.0.11 valid=10s ipv6=off;

    root /var/www/html;
    index index.php;
    client_max_body_size 64m;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        # Passing a *variable* makes nginx resolve the PHP pool per
        # request. With a literal host name it resolves once, at config
        # load: if nginx wins the boot race it exits with
        # [emerg] host not found in upstream, and a crash-looping
        # container loses its network sandbox and never recovers - which
        # is exactly what happened here, and what would happen again on
        # every reboot. This way nginx starts regardless, serves 502
        # until the pool is up, then heals itself.
        set $wp_upstream wordpress:9000;
        fastcgi_pass $wp_upstream;
        fastcgi_index index.php;
        # Path as seen inside the php-fpm container, not inside nginx.
        fastcgi_param SCRIPT_FILENAME /var/www/html$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        fastcgi_read_timeout 300;
    }

    # wp-config.php and friends must never be served as plain files.
    location ~* /(?:wp-config\.php|readme\.html|license\.txt|\.ht.*)$ {
        deny all;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ wordpress_pma_domain }};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;

    resolver 127.0.0.11 valid=10s ipv6=off;

    root /var/www/pma;
    index index.php;
    client_max_body_size 64m;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        # Resolved per request, same reasoning as the WordPress vhost.
        set $pma_upstream phpmyadmin:9000;
        fastcgi_pass $pma_upstream;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME /var/www/html$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_read_timeout 300;
    }
}
