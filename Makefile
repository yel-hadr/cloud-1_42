# cloud-1: terraform provisions the box, ansible configures it.
#
#   make up     provision + configure, end to end
#   make down   destroy everything (stops the billing)

TF      := terraform -chdir=terraform
KEY     := server_key.pem
PUBKEY  := server_key.pub

# Read from group_vars rather than duplicated here, so there is one place
# that defines the site's name. Override on the command line to test.
VARS    := group_vars/webservers/vars.yml
DOMAIN  := $(shell awk '/^wordpress_domain:/ {print $$2}' $(VARS))
LE      := $(shell awk '/^wordpress_tls_letsencrypt:/ {print $$2}' $(VARS))

.PHONY: up down provision inventory dns wait configure check lint fmt destroy-check

up: provision inventory dns wait configure

# Terraform reads the public half; ansible.cfg connects with the private
# half. Deriving one from the other keeps them in sync automatically.
$(PUBKEY): $(KEY)
	ssh-keygen -y -f $(KEY) > $(PUBKEY)

provision: $(PUBKEY)
	$(TF) init -input=false
	$(TF) apply -auto-approve

# Rewrites inventory.yaml from Terraform's output, so Ansible always targets
# the instance that actually exists rather than a stale hard-coded address.
inventory:
	@IP=$$($(TF) output -raw instance_public_ip) && \
	printf -- '---\n# Generated by `make inventory` from terraform output.\nwebservers:\n  hosts:\n    cloud1:\n      ansible_host: %s\n' "$$IP" > inventory.yaml && \
	echo "inventory.yaml -> $$IP"

# The playbook's Let's Encrypt preflight asserts that every certificate
# name resolves to ansible_host, but it only reaches that assertion after
# the whole stack is already up. On a rebuild behind a freshly allocated
# EIP, DNS still points at the old address, so `configure` deploys
# everything and then aborts - leaving the site on its self-signed
# bootstrap certificate. Checking here fails before anything is deployed.
#
# Deliberately not managed in Terraform: the domain is registered outside
# AWS, so there is no Route 53 zone to write these records into.
dns:
ifeq ($(LE),true)
	@IP=$$($(TF) output -raw instance_public_ip) && \
	bad=0; \
	for name in $(DOMAIN) www.$(DOMAIN) pma.$(DOMAIN); do \
		got=$$(getent ahostsv4 "$$name" 2>/dev/null | awk '{print $$1}' | sort -u | paste -sd, -); \
		if [ "$$got" != "$$IP" ]; then \
			echo "DNS: $$name -> $${got:-no answer} (expected $$IP)"; \
			bad=1; \
		else \
			echo "DNS: $$name -> $$IP"; \
		fi; \
	done; \
	if [ $$bad -ne 0 ]; then \
		echo; \
		echo "ERROR: DNS does not point at this instance. Update the A records"; \
		echo "above to $$IP and wait for propagation before deploying, or set"; \
		echo "wordpress_tls_letsencrypt: false in $(VARS) to deploy without"; \
		echo "a trusted certificate. Nothing has been deployed."; \
		exit 1; \
	fi
else
	@echo "dns: skipped (wordpress_tls_letsencrypt is not true)"
endif

# Wait for the instance to accept SSH before configuring it. A freshly
# created EC2 host needs cloud-init and sshd to finish before Ansible can
# connect; without this step `make up` fails on first run.
# Bounded to 60 attempts (≈5 min) so a persistent failure does not hang.
wait:
	@echo "Waiting for SSH on the new instance…"
	@n=0; \
	until ansible all -i inventory.yaml -m ansible.builtin.wait_for_connection -a 'timeout=10' 2>/dev/null; do \
		n=$$((n + 1)); \
		if [ $$n -ge 60 ]; then \
			echo "ERROR: instance did not become SSH-reachable after 60 attempts."; \
			echo "Check the key pair, security group, and instance console output."; \
			exit 1; \
		fi; \
		sleep 5; \
	done
	@echo "Instance is reachable."

configure:
	ansible-galaxy collection install -r requirements.yml
	ansible-playbook site.yml

# Dry run. Always worth doing before touching a working box.
check:
	ansible-playbook site.yml --check --diff

lint:
	ansible-lint
	$(TF) fmt -check -recursive
	$(TF) init -backend=false -input=false
	$(TF) validate

fmt:
	$(TF) fmt -recursive

down:
	$(TF) destroy -auto-approve
